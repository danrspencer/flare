__pycache__/
*.py[cod]
.pytest_cache/

# Automation traces captured by tests/behaviour/ (see its conftest.py).
# Build output - CI uploads them as an artifact and renders them into
# the job summary; there is nothing to gain from committing them.
trace-dumps/
junit.xml
.venv/
.venv-*/
venv/
*.egg-info/
.DS_Store

# Generated by dashboard/generate_preview_data.py - regenerate on demand,
# not worth committing (contains a "now" timestamp that's stale the
# moment it's written).

# Copied into the docs site at build time from its real home
# (custom_components/.../www/) so the site can never show a stale card -
# see .github/workflows/docs.yml.
docs/assets/js/flare-curve-card.js
docs/_site/
docs/_preview/
docs/.bundle/
docs/.jekyll-cache/
docs/vendor/
