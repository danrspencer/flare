{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8935",
        "--directory",
        "docs/_preview"
      ],
      "port": 8935
    },
    {
      "name": "sandbox",
      "runtimeExecutable": "mise",
      "runtimeArgs": [
        "run",
        "sandbox"
      ],
      "port": 8124
    },
    {
      "name": "sandbox-hacs",
      "runtimeExecutable": "mise",
      "runtimeArgs": [
        "run",
        "sandbox:hacs"
      ],
      "port": 8124
    }
  ]
}
